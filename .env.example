# ============================================================
# Supabase PostgreSQL connection
# ============================================================
#
# DATABASE_URL — used by BOTH the Python app (SQLAlchemy/pandas) and
# as the Prisma datasource `url`. Point it at the Supabase
# "Session Pooler" (port 5432): IPv4, supports prepared statements
# (required by pandas to_sql/read_sql) and persistent connections.
#
# Find it in: Supabase Dashboard -> Project -> Connect -> ORMs / Session pooler.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# DIRECT_URL — used ONLY by Prisma to run migrations (a direct,
# non-pooled connection). Find it under "Direct connection".
DIRECT_URL="postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"

# ============================================================
# LLM
# ============================================================
GEMINI_API_KEY=

# ============================================================
# Docker (optional)
# ============================================================
# Your Docker Hub username — used to name/push the images.
DOCKERHUB_USER=yourusername
# URL the BROWSER uses to reach the backend (baked into the frontend build).
VITE_API_BASE_URL=http://localhost:8000
# Browser origin(s) allowed by the backend CORS (comma-separated).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
